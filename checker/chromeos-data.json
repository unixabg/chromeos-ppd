{
  "about": "What ChromeOS provides to PPDs. Collected from chromiumos-overlay (app-text/ghostscript-gpl, net-print/*) and chromiumos/platform2 (foomatic_shell, debugd) in October 2026. Update when ChromeOS changes.",
  "add_printer_check": {
    "source": "platform2 debugd/src/cups_tool.cc TestPPD + lp_tools.cc CupsTestPpd",
