*NickName: "Rongta RP850P, ESCPOS ChromeOS (chromeos-thermal-ppd 1.1.0)"
*1284DeviceID: "MANUFACTURER:USB ;MODEL:80Series2;COMMENDSET:EPSON;CLASS:PRINTER;DESCRIPTION:RONGTA;"
*PSVersion: "(3010.000) 0"
*LanguageLevel: "3"
*ColorDevice: False
*DefaultColorSpace: Gray
*FileSystem: False
*Throughput: "1"
*LandscapeOrientation: Plus90
*TTRasterizer: Type42
*cupsVersion: 2.2
*cupsManualCopies: True
*cupsFilter: "application/vnd.cups-pdf 0 foomatic-rip"
*cupsFilter: "application/vnd.cups-postscript 100 foomatic-rip"
*FoomaticIDs: rongta-rp850p escpos
*FoomaticRIPCommandLine: "gs -q -dSAFER -dBATCH -dNOPAUSE -dQUIET -sDEVICE=uniprint -dupColorModel=/DeviceGray -dupRendering=/ErrorDiffusion -dupOutputFormat=/SunRaster '-dupComponentBits={1}'&&
 '-dupWhiteTransfer={1.0 0.0}' -r203 -dFIXEDMEDIA -dPDFFitPage -dPSFitPage '-dupBeginJobCommand=<1b40%D>' '-dupEndPageCommand=<%B>' '-dupEndJobCommand=<%C>' '-dupBeginPageCommand=<%A -sOutputFile=- -"
*FoomaticRIPCommandLinePDF: "gs -q -dSAFER -dBATCH -dNOPAUSE -dQUIET -sDEVICE=uniprint -dupColorModel=/DeviceGray -dupRendering=/ErrorDiffusion -dupOutputFormat=/SunRaster '-dupComponentBits={1}'&&
